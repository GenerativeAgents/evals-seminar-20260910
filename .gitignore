.env

node_modules/
.next/
tsconfig.tsbuildinfo
.venv/
__pycache__/
.deepeval/
.deepeval_telemetry.txt

# Ephemeral run workspaces and other local temporary files.
tmp/*
!tmp/.gitkeep

# Workspace AGENTS.md files are part of the sample (root .gitignore hides AGENTS.md).
!AGENTS.md

# Agent run byproducts inside workspaces. Evaluated artifacts live in results/.
workspaces/*/slides/
workspaces/*/large_tool_results/
